<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper
        PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "https://mybatis.org/dtd/mybatis-3-mapper.dtd">


<mapper namespace="kr.co.fitzstock.mapper.UserMapper">

    <!-- 사용자 등록 쿼리 -->
    <insert id="insertUser" parameterType="kr.co.fitzstock.entity.User">
        INSERT INTO user (username, password, email, nickname, role, created_at, updated_at)
        VALUES (#{username}, #{password}, #{email}, #{nickname}, #{role}, #{createdAt}, #{updatedAt})
    </insert>

    <!-- 아이디로 사용자 찾기 -->
    <select id="findByEmail" parameterType="String" resultType="kr.co.fitzstock.entity.User">
        SELECT * FROM user WHERE email = #{email}
    </select>

</mapper>